<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <display-name>AluGhadi Watches</display-name>

    <!-- Welcome files -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session configuration -->
    <session-config>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Friendly URL mappings (no .jsp required) -->
    <servlet>
        <servlet-name>productsPage</servlet-name>
        <jsp-file>/WEB-INF/views/products.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>productsPage</servlet-name>
        <url-pattern>/products</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>giftingPage</servlet-name>
        <jsp-file>/WEB-INF/views/gifting.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>giftingPage</servlet-name>
        <url-pattern>/gifting</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>forHimPage</servlet-name>
        <jsp-file>/WEB-INF/views/for-him.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>forHimPage</servlet-name>
        <url-pattern>/for-him</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>forHerPage</servlet-name>
        <jsp-file>/WEB-INF/views/for-her.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>forHerPage</servlet-name>
        <url-pattern>/for-her</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>aboutPage</servlet-name>
        <jsp-file>/WEB-INF/views/about.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>aboutPage</servlet-name>
        <url-pattern>/about</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>contactPage</servlet-name>
        <jsp-file>/WEB-INF/views/contact.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>contactPage</servlet-name>
        <url-pattern>/contact</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>loginPage</servlet-name>
        <jsp-file>/WEB-INF/views/login.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>loginPage</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>registerPage</servlet-name>
        <jsp-file>/WEB-INF/views/register.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>registerPage</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>logoutPage</servlet-name>
        <jsp-file>/WEB-INF/views/logout.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>logoutPage</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

</web-app>
